{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "@paleta": ["../../frontend/src/shared/theme/paleta.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "env.d.ts", "../../frontend/src/shared/theme/paleta.ts"]
}
